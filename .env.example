# Скопируйте этот файл в .env и заполните значения.
# Файл .env никогда не должен попадать в git.

# --- LLM (DeepSeek, OpenAI-совместимый API) ---
# Провайдер LLM по умолчанию: deepseek | ollama.
# Для сервера с локальной LLM (например, в VM/"домашнем сервере") укажите ollama.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Локальная LLM (Ollama, OpenAI-совместимый API) ---
# Выбор провайдера — в дропдауне под заголовком в веб-интерфейсе.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
# Ограничение длины ответа локальной модели (экономия токенов).
OLLAMA_CHAT_MAX_TOKENS=1000

# --- HTTP сервер ---
HOST=127.0.0.1
PORT=8000

# Список origin-ов для CORS через запятую (dev-сервер Vite и прод-домен)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
